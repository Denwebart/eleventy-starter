{
  "name": "eleventy",
  "type": "module",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "start chrome http://localhost:8080 & run-p dev:11ty dev:css",
    "dev:11ty": "eleventy --serve",
    "dev:css": "tailwindcss -i ./src/css/style.css -o ./dist/css/style.css --watch",
    "build": "run-s build:css build:11ty",
    "build:css": "tailwindcss -i ./src/css/style.css -o ./dist/css/style.css --minify",
    "build:11ty": "eleventy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.3",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@tailwindcss/cli": "^4.2.4",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "prettier-plugin-classnames": "^0.10.1",
    "prettier-plugin-merge": "^0.10.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.4"
  }
}
